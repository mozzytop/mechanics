# Copy this file to .env and fill in your own values. Never commit .env.

# Required for the Code Lookup Tool's "relevant videos" feature.
# Get a free key from Google Cloud Console with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=

# Required for the Part Lookup Tool's search/compare/table generation.
# Get a free key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional. Only needed if you decide you want the supplemental OE
# cross-reference lookup from apiprofile.com's AutoPartsAPI.
# Regenerate any key that has ever been shared/screenshotted before using it here.
AUTOPARTS_API_KEY=

# Your city/zip so you don't have to re-type it on every search.
DEFAULT_LOCATION=

# Optional overrides
GEMINI_MODEL=gemini-2.0-flash
DATABASE_PATH=data/virtual_mechanic.db
